#!/bin/zsh
# Edit these two percentages to change the initial split. They must total 100.
# Existing sessions keep their current layout.
readonly NVIM_PERCENT=65
readonly CODEX_PERCENT=35

set -eu
setopt PIPE_FAIL

die() { print -u2 -r -- "dev: $*"; exit 1; }
[[ $NVIM_PERCENT == <-> && $CODEX_PERCENT == <-> ]] || die 'pane percentages must be integers.'
if (( NVIM_PERCENT <= 0 || CODEX_PERCENT <= 0 || NVIM_PERCENT + CODEX_PERCENT != 100 )); then
  die 'NVIM_PERCENT and CODEX_PERCENT must be positive integers totaling 100.'
fi

(( $# <= 1 )) || die 'usage: dev [project-directory]'
# Resolve symlinks so different names for the same directory reuse one session.
project=$(cd -- "${1:-$PWD}" && pwd -P) || die 'project directory does not exist or is inaccessible.'

for tool in tmux nvim codex; do
  command -v "$tool" >/dev/null || die "missing $tool; install it and ensure it is on your PATH. For tmux: brew install tmux"
done
tmux -V >/dev/null || die 'tmux cannot start; try brew reinstall tmux.'

if [[ -n ${TMUX:-} ]]; then
  # Split the invoking pane in its existing window. Keep tmux's environment
  # intact so the split uses the same server, even with a custom socket.
  pane=${TMUX_PANE:?missing tmux pane}
  tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null || die 'cannot find the invoking tmux pane.'
  nvim_path=$(command -v nvim)
  codex_path=$(command -v codex)
  # Start Codex in a new lower pane, then replace this pane's shell with Neovim.
  # Full executable paths avoid relying on tmux's possibly older PATH.
  tmux split-window -d -v -l "${CODEX_PERCENT}%" -t "$pane" -c "$project" "exec ${(q)codex_path}" || die 'could not split the current pane.'
  tmux select-pane -t "$pane"
  # Replacing the shell avoids a command queued behind this running script.
  exec tmux respawn-pane -k -t "$pane" -c "$project" "exec ${(q)nvim_path} ."
fi

command -v python3 >/dev/null || die 'missing python3; install it and ensure it is on your PATH.'
# The readable directory name helps `tmux list-sessions`; the path hash keeps
# projects with the same basename from colliding.
session=$(python3 - "$project" <<'PYSESSION'
import hashlib, os, re, sys
path = sys.argv[1]
label = re.sub(r'[^a-zA-Z0-9_-]', '-', os.path.basename(path))[:40] or 'root'
print('dev-' + label + '-' + hashlib.sha256(os.fsencode(path)).hexdigest()[:16])
PYSESSION
)

# A previous failed launch may have left a project session with only a shell.
# Keep any existing windows; create an editor window when no live pair exists.
if ! tmux has-session -t "=$session" 2>/dev/null; then
  # Size the detached session like this terminal before calculating the split.
  # A pipe or other non-terminal caller gets a usable fallback size.
  terminal_size=$(stty size 2>/dev/null || true)
  rows=${terminal_size%% *}
  columns=${terminal_size##* }
  [[ $rows == <-> && $columns == <-> ]] || { rows=40; columns=120; }
  tmux new-session -d -s "$session" -c "$project" -n editor -x "$columns" -y "$rows" || die 'could not create the tmux session.'
  editor_window=$(tmux display-message -p -t "=$session:" '#{window_id}')
  needs_editor=1
else
  editor_window=$(tmux list-windows -t "=$session" -F '#{window_id} #{window_name}' | awk '$2 == "editor" {print $1; exit}')
  needs_editor=1
  if [[ -n $editor_window ]]; then
    # Process names can change (for example, wrapper scripts); tmux retains
    # the commands used to start the panes, which identify this editor pair.
    pane_commands=$(tmux list-panes -t "$editor_window" -F '#{pane_start_command}')
    if [[ $pane_commands == *nvim* && $pane_commands == *codex* ]]; then
      needs_editor=0
    fi
  fi
  if (( needs_editor )); then
    editor_window=$(tmux new-window -d -P -F '#{window_id}' -t "=$session:" -n editor -c "$project") || die 'could not create the editor window.'
  fi
fi

if (( needs_editor )); then
  # Configure the two-pane layout before attaching, then launch both programs.
  editor_pane=$(tmux display-message -p -t "$editor_window" '#{pane_id}')
  nvim_path=$(command -v nvim)
  codex_path=$(command -v codex)
  tmux set-window-option -t "$editor_window" main-pane-height "${NVIM_PERCENT}%"
  tmux split-window -d -v -l "${CODEX_PERCENT}%" -t "$editor_pane" -c "$project" "exec ${(q)codex_path}" || die 'could not split the editor window.'
  tmux select-layout -t "$editor_window" main-horizontal
  tmux respawn-pane -k -t "$editor_pane" -c "$project" "exec ${(q)nvim_path} ." || die 'could not start Neovim.'
fi

# Reuse a healthy workspace or show the new editor window in this terminal.
tmux select-window -t "$editor_window"
editor_pane=$(tmux display-message -p -t "$editor_window" '#{pane_id}')
tmux select-pane -t "$editor_pane" 2>/dev/null || true
exec tmux attach-session -t "=$session"
