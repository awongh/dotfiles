#!/usr/bin/env python3
"""Run `scripts/dev [project-directory]` to open Neovim above Codex.

Inside tmux, split the invoking pane in its current window. Outside tmux,
create or reuse a tmux session for the project in the current terminal.
"""

import hashlib
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys

# Set the initial heights of the upper Neovim and lower Codex panes.
# Change these together; existing sessions keep their current layout.
NVIM_PERCENT = 65
CODEX_PERCENT = 35


def fail(message):
    print(f"dev: {message}", file=sys.stderr)
    raise SystemExit(1)


def tmux(*args, check=True):
    """Run tmux, preserving its stdout for IDs and pane information."""
    result = subprocess.run([TMUX, *args], text=True, capture_output=True)
    if check and result.returncode:
        fail(result.stderr.strip() or f"tmux {args[0]} failed")
    return result


def output(*args):
    return tmux(*args).stdout.strip()


def app_command(executable, *args):
    # tmux passes one command string to a shell; quote each argument there.
    return shlex.join(["exec", executable, *args])


def start_pair(pane, window, project, nvim, codex, inside_tmux):
    """Split the original pane and run each app in the project directory."""
    # For a new project window, retain the configured upper-pane percentage
    # when tmux chooses its horizontal layout. In an existing window, size only
    # the pane being split so the user's other panes are not rearranged.
    if not inside_tmux:
        tmux("set-window-option", "-t", window, "main-pane-height", f"{NVIM_PERCENT}%")
    # -d leaves the original pane focused; -c gives Codex the project directory.
    result = tmux(
        "split-window", "-d", "-v", "-l", f"{CODEX_PERCENT}%",
        "-t", pane, "-c", str(project), app_command(codex), check=False,
    )
    if result.returncode:
        fail(result.stderr.strip() or "could not split the current pane")
    if not inside_tmux:
        tmux("select-layout", "-t", window, "main-horizontal")
    else:
        tmux("select-pane", "-t", pane)
    # Replace the shell running this script. Sending keys would queue Neovim
    # behind the script and could leave the original pane at a shell prompt.
    tmux("respawn-pane", "-k", "-t", pane, "-c", str(project), app_command(nvim, "."))


def session_name(project):
    # The readable prefix helps in `tmux list-sessions`; the hash distinguishes
    # projects with the same basename and follows resolved symlinks.
    label = re.sub(r"[^a-zA-Z0-9_-]", "-", project.name)[:40] or "root"
    digest = hashlib.sha256(os.fsencode(project)).hexdigest()[:16]
    return f"dev-{label}-{digest}"


def main():
    # Reject invalid constants before changing any tmux session or pane.
    if not isinstance(NVIM_PERCENT, int) or not isinstance(CODEX_PERCENT, int):
        fail("pane percentages must be integers")
    if NVIM_PERCENT <= 0 or CODEX_PERCENT <= 0 or NVIM_PERCENT + CODEX_PERCENT != 100:
        fail("NVIM_PERCENT and CODEX_PERCENT must be positive integers totaling 100")
    if len(sys.argv) > 2:
        fail("usage: dev [project-directory]")
    try:
        # Resolving symlinks makes two paths to the same project share a session.
        project = Path(sys.argv[1] if len(sys.argv) == 2 else os.getcwd()).resolve(strict=True)
        if not project.is_dir():
            fail("project path is not a directory")
    except (OSError, RuntimeError):
        fail("project directory does not exist or is inaccessible")

    global TMUX
    TMUX = shutil.which("tmux")
    nvim = shutil.which("nvim")
    codex = shutil.which("codex")
    for name, path in (("tmux", TMUX), ("nvim", nvim), ("codex", codex)):
        if not path:
            fail(f"missing {name}; install it and ensure it is on your PATH")
    tmux("-V")

    if os.environ.get("TMUX"):
        # TMUX_PANE identifies exactly where the command was invoked. Keep the
        # tmux environment so custom sockets and surrounding panes are preserved.
        pane = os.environ.get("TMUX_PANE") or fail("missing tmux pane")
        if output("display-message", "-p", "-t", pane, "#{pane_id}") != pane:
            fail("cannot find the invoking tmux pane")
        start_pair(pane, "", project, nvim, codex, inside_tmux=True)
        return

    name = session_name(project)
    if tmux("has-session", "-t", f"={name}", check=False).returncode:
        # tmux needs a size while the session is detached. Use this terminal's
        # dimensions so its first split looks right when we attach below.
        try:
            size = os.get_terminal_size()
            columns, rows = size.columns, size.lines
            if columns <= 0 or rows <= 0:
                raise OSError
        except OSError:
            columns, rows = 120, 40
        tmux("new-session", "-d", "-s", name, "-c", str(project),
             "-n", "editor", "-x", str(columns), "-y", str(rows))
        window = output("display-message", "-p", "-t", f"={name}:", "#{window_id}")
        needs_editor = True
    else:
        # Reattach when the project already has a live editor pair. Keep the
        # session's other windows if an old editor window needs replacement.
        windows = output("list-windows", "-t", f"={name}", "-F", "#{window_id} #{window_name}")
        window = next((line.split(" ", 1)[0] for line in windows.splitlines()
                       if line.endswith(" editor")), "")
        needs_editor = True
        if window:
            # Pane start commands survive wrapper processes that change the
            # running process name. A failed prior launch gets a new window.
            commands = output("list-panes", "-t", window, "-F", "#{pane_start_command}")
            needs_editor = not ("nvim" in commands and "codex" in commands)
        if needs_editor:
            window = output("new-window", "-d", "-P", "-F", "#{window_id}",
                            "-t", f"={name}:", "-n", "editor", "-c", str(project))

    if needs_editor:
        pane = output("display-message", "-p", "-t", window, "#{pane_id}")
        start_pair(pane, window, project, nvim, codex, inside_tmux=False)

    # Show the chosen editor window here. exec hands this terminal to tmux
    # without leaving a Python process waiting behind the tmux client.
    tmux("select-window", "-t", window)
    pane = output("display-message", "-p", "-t", window, "#{pane_id}")
    tmux("select-pane", "-t", pane, check=False)
    os.execv(TMUX, [TMUX, "attach-session", "-t", f"={name}"])


if __name__ == "__main__":
    main()
